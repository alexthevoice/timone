# Timone — variabili d'ambiente
#
# Copia questo file in .env.local e riempi i valori.
# .env.local non finisce mai nel controllo di versione (.gitignore ha .env*).
# Online gli stessi valori vanno nel pannello di Vercel, PER TUTTI GLI AMBIENTI,
# non solo produzione: le anteprime senza segreti girano senza cancello.
# Dopo ogni modifica alle variabili serve un nuovo deploy: vengono lette
# al momento della build, non a ogni richiesta.

# --- Il nome -----------------------------------------------------------------
# Come si chiama la TUA dashboard. Compare nella barra, nel login e nel titolo
# della finestra. Se la lasci vuota vale il nome predefinito in lib/app.js.
NEXT_PUBLIC_APP_NAME=

# --- Modelli -----------------------------------------------------------------
# console.anthropic.com -> API Keys. Serve credito, ed e separata
# dall'abbonamento a Claude. METTI UN LIMITE DI SPESA MENSILE.
ANTHROPIC_API_KEY=
# Facoltativa: nel codice c'e un valore predefinito. Serve a cambiare modello
# senza andare a cercare il nome in cinque file diversi.
ANTHROPIC_MODEL=
# Facoltativa. Lo smistamento e le risposte sono due mestieri diversi: smistare
# deve essere veloce (tu aspetti davanti alla barra), rispondere deve essere
# bravo. Se la lasci vuota si usa ANTHROPIC_MODEL per entrambi.
# Per una barra di cattura quasi istantanea: claude-haiku-4-5
ANTHROPIC_MODEL_SMISTAMENTO=

# platform.openai.com -> API Keys. Serve solo per trascrivere le note vocali
# di Telegram: senza, il resto funziona lo stesso. Limite di spesa anche qui.
OPENAI_API_KEY=

# --- Database (Airtable) -----------------------------------------------------
# airtable.com/create/tokens -> token di accesso personale.
# Permessi: data.records:read, data.records:write, schema.bases:read
# (e schema.bases:write se vuoi far creare le tabelle allo script).
# Accesso: solo la base di questa dashboard.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- Calendario --------------------------------------------------------------
# Le agende, separate da punto e virgola. Il nome davanti all'uguale e
# facoltativo ed e quello che compare nella legenda della scheda.
#
#   GOOGLE_CALENDAR_ICAL_URLS=Lavoro = https://.../basic.ics; Famiglia = https://.../basic.ics
#
# Per ognuna: Google Calendar -> impostazioni di QUEL calendario -> "Indirizzo
# segreto in formato iCal". ATTENZIONE: quell'indirizzo e una password.
# Chiunque lo conosca legge tutto quel calendario. Se ti scappa, rigeneralo.
GOOGLE_CALENDAR_ICAL_URLS=

# --- Telegram ----------------------------------------------------------------
# Facoltativo: senza, niente cattura al volo dal telefono e niente briefing.
# @BotFather -> /newbot. Il token te lo da una volta sola.
TELEGRAM_BOT_TOKEN=
# openssl rand -hex 32. Telegram lo rimanda a ogni chiamata in un'intestazione:
# e cosi che il tuo endpoint distingue Telegram da chiunque altro.
TELEGRAM_WEBHOOK_SECRET=
# @userinfobot ti dice il tuo id numerico. Il bot ignora chiunque altro.
TELEGRAM_USER_ID=

# --- Sicurezza ---------------------------------------------------------------
# openssl rand -hex 32. Firma i cookie di sessione. Incollalo senza guardarlo.
AUTH_SECRET=
# La password che digiti tu per entrare. UNA FRASE LUNGA, non otto caratteri:
# niente impedisce a qualcuno di provarne diecimila.
DASHBOARD_PASSWORD=
# openssl rand -hex 32. Accesso da script e scorciatoie del telefono.
API_SECRET=
# openssl rand -hex 32. Su Vercel viene inviato in automatico come
# Authorization: Bearer sulle chiamate del cron.
CRON_SECRET=

# --- Varie -------------------------------------------------------------------
# Il dominio pubblico, dopo il primo deploy. Serve per registrare il webhook.
NEXT_PUBLIC_APP_URL=
# Il fuso in cui vivi. Decide quando "oggi" diventa "ieri".
USER_TIMEZONE=Europe/Rome
